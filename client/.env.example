# Copy to .env and fill in. NEVER commit a real .env or any private key.

# --- Privy (client) ---
# HTTPS is mandatory for Privy in production; dev is allowed on http://localhost only.
VITE_PRIVY_APP_ID=

# --- Chain / RPC (client + server) ---
VITE_RPC_URL=http://127.0.0.1:8899
VITE_PROGRAM_ID=FQ95QLushdus3WQv193HyedsVg3TGHqhw7dLpJtY5sgV

# USDC mint the pool accepts (devnet/localnet test mint or mainnet USDC).
VITE_USDC_MINT=

# Pool PDA seed the operator initialized the pool with.
VITE_POOL_SEED=0

# --- Fee sponsorship (public keys only — operator holds the secrets elsewhere) ---
# Gas wallet pays SOL fees (feePayer). Public key only on the client.
VITE_GAS_WALLET=
# Collection wallet receives the USDC service fee. Its USDC ATA is derived at runtime.
VITE_COLLECTION_WALLET=
# Service fee in USDC base units (6 decimals). e.g. 10000 = 0.01 USDC.
VITE_FEE_AMOUNT=10000

# Backend sponsor endpoint the client POSTs the user-signed tx to.
VITE_SPONSOR_URL=http://127.0.0.1:8787/sponsor

# --- Server only (never exposed to the client bundle) ---
SPONSOR_PORT=8787
RPC_URL=http://127.0.0.1:8899
# Path to the gas wallet keypair JSON the sponsor partial-signs with.
# Operator-held. Do NOT point this at ~/.config/solana/id.json or any funded mainnet key.
GAS_WALLET_KEYPAIR=./.gas-wallet.json

# Dev-only signer switch (client). When "1", uses a local keypair instead of Privy.
VITE_DEV_SIGNER=0
