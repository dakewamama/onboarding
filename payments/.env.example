# Paj payment module config. Copy to .env and fill in. NEVER commit real keys.

# API key (x-api-key). Needed ONLY for outbound calls (createPayment,
# paj-verify-receiver). The webhook receiver does NOT use it — do not set it on the
# receiver host. Staging and production keys are provisioned separately (a
# production key returns 400 "Can't find business" on staging).
PAJ_API_KEY=

# Webhook signing secret. This is RETURNED by PATCH /pub/v2/webhook when you
# register your URL (format: whsec_ + 64 hex). Needed by the receiver to verify
# signatures. The v2 dashboard has no webhook UI; registration is API-only.
PAJ_WEBHOOK_SECRET=

# "staging" or "production".
PAJ_ENV=staging

# "OFFRAMP" (crypto -> naira bank payout) or "PAYMENT" (collect USDC only).
PAJ_MODE=OFFRAMP

# Chain + token. On STAGING the mainnet USDC mint 404s; set the staging test mint.
PAJ_CHAIN=SOLANA
PAJ_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
PAJ_CURRENCY=NGN

# Public URL of your webhook receiver (used by paj-verify-receiver).
PAJ_WEBHOOK_URL=

# Optional merchant surcharge in USDC (wire field businessUSDCFee).
# PAJ_BUSINESS_USDC_FEE=

# Optional override for the local store directory.
# PAJ_STORE_DIR=

# ---------------------------------------------------------------------------
# Crypto funding (USDC on Solana) — additive path, runs alongside Paj. Leave
# SOLANA_RPC_URL unset to keep the funding routes disabled (Paj still works).
# ---------------------------------------------------------------------------

# JSON-RPC endpoint. REQUIRED to enable the funding flow. No default (a misconfig
# must fail loudly rather than silently hit some public node).
SOLANA_RPC_URL=

# USDC SPL mint. Defaults to mainnet USDC; override on devnet/staging.
SOLANA_USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# Commitment a deposit must reach before it is credited: "confirmed" or
# "finalized". Default "finalized" — the strictest, safest for crediting money.
SOLANA_COMMITMENT=finalized

# Watcher poll interval (ms) and signatures pulled per address per poll.
# FUNDING_POLL_INTERVAL_MS=15000
# FUNDING_PAGE_SIZE=25

# Store directory: custodial wallet keys, identity links, the watchlist. The image
# defaults it to /data; attach a persistent volume there, or redeploys lose the
# wallet keys (and with them the funds).
# FUNDING_STORE_DIR=/data

# --- Axis Money ledger (required in production) ---
# Postgres for balances, spends and deposits. NODE_ENV=production refuses to start
# without it. Locally, leaving it unset uses the development-only file ledger.
# Import an existing file ledger once with: yarn money-import [FUNDING_STORE_DIR]
DATABASE_URL=
# Optional: a separate database for Axis Money (defaults to DATABASE_URL).
# MONEY_DATABASE_URL=

# Legacy /offramp payout route (no idempotency key). Off unless explicitly enabled.
# AXIS_LEGACY_OFFRAMP_ENABLED=false

# --- Service ---
# production refuses to start without the Postgres money ledger.
NODE_ENV=
PORT=8788
# Bearer token brain and the web app use for every non-webhook route. Required.
INTERNAL_API_TOKEN=
# 64 hex chars (32 bytes): wraps each user's custodial wallet key. Required for
# wallets; keep it stable and backed up, or the wallets cannot be opened.
KEYSTORE_MASTER_KEY=

# --- Airtime (VTpass) ---
VTPASS_ENV=sandbox
VTPASS_API_KEY=
VTPASS_SECRET_KEY=
VTPASS_PUBLIC_KEY=
# USDC->NGN rate when PAJ is not configured (NGN per USDC), and an optional
# margin over cost in basis points.
# AXIS_USDC_NGN_RATE=
# AXIS_AIRTIME_MARGIN_BPS=0

# --- Custody transfers (POST /wallet/transfer, used by brain's merchant payments) ---
AXIS_CUSTODY_TRANSFER_ENABLED=false
# JSON array secret key of the fee-paying operator account.
SOLANA_OPERATOR_KEYPAIR_JSON=

# --- SOL deposits are credited at a live SOL->USDC price ---
# SOL_USDC_PRICE=            fixed price override
# SOL_PRICE_URL=             price endpoint (default: CoinGecko simple price)
# SOL_PRICE_JSON_PATH=       path to the price in that response

# --- Treasury control status (GET /treasury/status) ---
# AXIS_SQUADS_ENABLED=false
# AXIS_SQUADS_MULTISIG=
# AXIS_SQUADS_VAULT=
# AXIS_SQUADS_EXECUTOR=
# AXIS_SQUADS_VAULT_INDEX=0
