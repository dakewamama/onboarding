# Paj payment module config. Copy to .env and fill in. NEVER commit real keys.

# API key (x-api-key). Staging and production keys are provisioned separately:
# a production key returns 400 "Can't find business" on staging.
PAJ_API_KEY=

# Webhook signing secret from your API key settings (format: whsec_ + 64 hex).
PAJ_WEBHOOK_SECRET=

# "staging" or "production".
PAJ_ENV=staging

# "OFFRAMP" (crypto -> naira bank payout) or "PAYMENT" (collect USDC only).
PAJ_MODE=OFFRAMP

# Chain + token. On STAGING the mainnet USDC mint 404s; set the staging test mint.
PAJ_CHAIN=SOLANA
PAJ_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
PAJ_CURRENCY=NGN

# Public URL of your webhook receiver (used by paj-verify-receiver).
PAJ_WEBHOOK_URL=

# Optional merchant surcharge in USDC (wire field businessUSDCFee).
# PAJ_BUSINESS_USDC_FEE=

# Optional override for the local store directory.
# PAJ_STORE_DIR=
